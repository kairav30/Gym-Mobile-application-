<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#D3D3D3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/exerciseButton"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/exercise"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.66"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalised Profile:"
        android:textSize="35dp"
        android:textColor="#0000FF"
        android:textStyle="italic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/GenderInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="Male/Female."
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="61dp"
        app:layout_constraintTop_toBottomOf="@id/profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/HeightInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="Enter your height in cm."
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="61dp"
        app:layout_constraintTop_toBottomOf="@id/GenderInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/WeightInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="Enter your weight in KG."
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="61dp"
        app:layout_constraintTop_toBottomOf="@id/HeightInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ProgressBar
        android:id="@+id/calorieProgressTracker"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:progress="0"
        android:max="1500"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/WeightInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp" />

    <EditText
        android:id="@+id/CalorieGoalsInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your Calorie Goal Here"
        android:inputType="number"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <LinearLayout
        android:id="@+id/goalButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/calorieProgressTracker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp">

        <Button
            android:id="@+id/goal10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 Cal" />

        <Button
            android:id="@+id/goal100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 Cal"
            android:layout_marginStart="10dp"/>

        <Button
            android:id="@+id/goal1000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000 Cal"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/Goalbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Set calories goal!"
        android:textColorHint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/exerciseButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/CalorieGoalsInput"
        app:layout_constraintVertical_bias="0.202" />

    <TextView
        android:id="@+id/Workout_Page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Workout Tracker page"
        android:textColor="#0000FF"
        android:textSize="15dp"
        app:layout_constraintBottom_toTopOf="@+id/exerciseButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.718"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/info_button"
        android:layout_width="89dp"
        android:layout_height="81dp"
        android:scaleType="fitCenter"
        android:src="@drawable/info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/exerciseButton"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/infomation_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Fitness Information"
        android:textSize="15dp"
        android:textColor="#0000FF"
        app:layout_constraintBottom_toTopOf="@+id/info_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.162"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>